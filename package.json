{
  "name": "qq-ai-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Agent with memory, tools and a QQ channel adapter.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/app/demo.ts",
    "typecheck": "tsc --noEmit",
    "napcat": "tsx --env-file-if-exists=.env src/app/napcat.ts",
    "bot:status": "tsx --env-file-if-exists=.env src/app/instance.ts status",
    "bot:stop": "tsx --env-file-if-exists=.env src/app/instance.ts stop",
    "bot:start": "tsx --env-file-if-exists=.env src/app/instance.ts start",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "replay": "node --import tsx src/app/replay.ts",
    "memes:index": "node --import tsx --env-file-if-exists=.env src/app/meme-index.ts",
    "replay:events": "node --import tsx src/app/event-replay.ts",
    "observe:events": "node --import tsx --env-file-if-exists=.env src/app/event-observe-report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
