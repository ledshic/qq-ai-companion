{
  "name": "qq-ai-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Agent with memory, tools and a QQ channel adapter.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/app/demo.ts",
    "typecheck": "tsc --noEmit",
    "napcat": "tsx --env-file-if-exists=.env src/app/napcat.ts",
    "bot:status": "tsx --env-file-if-exists=.env src/app/instance.ts status",
    "bot:stop": "tsx --env-file-if-exists=.env src/app/instance.ts stop",
    "bot:start": "tsx --env-file-if-exists=.env src/app/instance.ts start",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "replay": "node --import tsx src/app/replay.ts",
    "memes:index": "node --import tsx --env-file-if-exists=.env src/app/meme-index.ts",
    "replay:events": "node --import tsx src/app/event-replay.ts",
    "observe:events": "node --import tsx --env-file-if-exists=.env src/app/event-observe-report.ts",
    "mock:api": "pnpm --filter @companion/mock-api dev",
    "web:dev": "pnpm --filter @companion/web dev",
    "web:build": "pnpm --filter @companion/web build",
    "native:dev": "pnpm --filter @companion/native dev",
    "native:build": "pnpm --filter @companion/native build",
    "typecheck:clients": "pnpm -r --if-present typecheck",
    "test:clients": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/mock-api/**/*.test.ts\"",
    "test:web": "pnpm --filter @companion/web test:e2e",
    "native:ios:open": "bash scripts/clients/native.sh ios dev --open --no-watch --features tauri/custom-protocol --config src-tauri/tauri.simulator.conf.json --no-dev-server",
    "native:ios:sim": "bash scripts/clients/ios-simulator.sh",
    "agent:serve": "tsx --env-file-if-exists=.env src/app/service.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@companion/contracts": "workspace:*",
    "fastify": "^5.12.7",
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
