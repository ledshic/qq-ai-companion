{
  "name": "qq-ai-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal foundation for a QQ AI companion.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "napcat": "tsx --env-file-if-exists=.env src/napcat.ts",
    "test": "tsx --test src/*.test.ts",
    "replay": "node --import tsx src/replay.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
