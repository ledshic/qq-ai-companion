NAPCAT_WS_URL=ws://127.0.0.1:3001/
NAPCAT_TOKEN=

# Docker NapCat WebUI password (different from NAPCAT_TOKEN)
NAPCAT_WEBUI_TOKEN=

# Saved bot QQ account for quick login after a restart
NAPCAT_ACCOUNT=

# Set true after adding your private DeepSeek API key
LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# legacy keeps original persona; modular enables bounded context analysis and expression plans
PERSONALITY_MODE=legacy

# Observe eligible follow-ups; never send automatic follow-up replies
FOLLOW_UP_OBSERVE=false

# unified = calls, rolling follow-ups and separately limited interjections
# window / always remain available for rollback
FOLLOW_UP_MODE=unified

# Auto-reply only when observe mode is off; max 2 per fixed 60-second window
FOLLOW_UP_AUTO=true

# unified: proactive interjections only; follow-ups and explicit calls use separate rules
# always: all judged replies share these limits
AUTO_REPLY_COOLDOWN_SECONDS=45
AUTO_REPLY_HOURLY_CAP=12

# SQLite file for conversation memory (created on first run); :memory: disables persistence
MEMORY_DB=data/memory.db

# Maximum concurrent model calls (1-16). Work above the cap waits for a free slot
MAX_INFLIGHT=3

# Conversation turns kept per (group, sender)
MEMORY_TURNS=9

# Maximum number of active follow-up windows kept at once (oldest is evicted)
MAX_WINDOWS=12

# How long a follow-up window stays open after a successful reply
WINDOW_SECONDS=90

# Chance (0-1) that an ordinary group message triggers an unprompted reply; 0 disables
INTERJECT_PROBABILITY=0.15
# Minimum gap between two interjections in the same group
INTERJECT_COOLDOWN_SECONDS=90

# Occasionally open a topic in a quiet group
WARMUP_ENABLED=true
# Local hours, supports wrap-around such as 22-2
WARMUP_HOURS=9-23
WARMUP_PROBABILITY=0.5
WARMUP_INTERVAL_MINUTES=20
# Per-group cooldown, and how recently the group must have been active to be picked
WARMUP_COOLDOWN_MINUTES=40
WARMUP_IDLE_MINUTES=25

# Short-lived structured group discussion, distinct from per-person SQLite memory
GROUP_CONTEXT_MESSAGES=60
GROUP_CONTEXT_SECONDS=300

# DeepSeek public web search; shares DEEPSEEK_API_KEY, explicit calls / follow-ups only
WEB_SEARCH_ENABLED=false

# Explicit single-image requests only. Shares DEEPSEEK_API_KEY; no automatic group image reading.
VISION_ENABLED=false
VISION_MODEL=deepseek-flash

# Optional concrete meme selection from the annotated local Tieba catalog
MEMES_ENABLED=false
# Successful text replies required between meme attempts; no consecutive images
MEME_REPLY_GAP=7

# Personal event memory: allowlisted groups plus direct chats; no proactive sends
# Group/private context stays separate. Private facts need explicit topic disclosure in groups.
EVENT_MEMORY_ENABLED=false
EVENT_MEMORY_GROUPS=
EVENT_MEMORY_SCOPE=addressed
EVENT_FOLLOWUP_MODE=off
