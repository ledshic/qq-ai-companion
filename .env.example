# Agent service, loopback only
AGENT_PORT=4320
# Exact trusted browser origins, comma-separated; blank permits only service origins
AGENT_WEB_ORIGINS=

# Enable only after adding your private model key
LLM_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
WEB_SEARCH_ENABLED=false

# Existing database path and adjacent bot.lock/service-owner.json remain unchanged
MEMORY_DB=data/memory.db
MAX_INFLIGHT=3
MEMORY_TURNS=9

# Optional sourced recall; cross-conversation sources require explicit owner grants
AGENT_MEMORY_ENABLED=false
# Expression only: whale or none
AGENT_PERSONA=whale
